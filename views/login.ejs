<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Sign In — DiabetesCare</title>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
  <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">
  <link rel="stylesheet" href="/auth.css">
</head>
<body>

  <div class="auth-page">

    <!-- Left panel -->
    <div class="auth-left">
      <div class="brand">
        <i class="fas fa-heartbeat brand-icon"></i>
        <span>DiabetesCare</span>
      </div>
      <div class="auth-left-content">
        <h2>Monitor. Manage. Thrive.</h2>
        <p>Track your daily glucose, meals, activity and wellness — all in one place.</p>
        <ul class="feature-list">
          <li><i class="fas fa-check-circle"></i> Daily health tracking</li>
          <li><i class="fas fa-check-circle"></i> Personalised recommendations</li>
          <li><i class="fas fa-check-circle"></i> PDF health reports</li>
          <li><i class="fas fa-check-circle"></i> Bilingual support</li>
        </ul>
      </div>
    </div>

    <!-- Right panel -->
    <div class="auth-right">
      <div class="auth-card">
        <div class="auth-card-header">
          <h1>Welcome back</h1>
          <p>Sign in to your account to continue</p>
        </div>

        <% if (error) { %>
          <div class="alert alert-error">
            <i class="fas fa-exclamation-circle"></i> <%= error %>
          </div>
        <% } %>

        <form action="/login" method="POST" class="auth-form">

          <div class="input-wrap">
            <label for="email">Email Address</label>
            <div class="input-icon-wrap">
              <i class="fas fa-envelope input-icon"></i>
              <input type="email" id="email" name="email" required placeholder="your@email.com" autocomplete="email">
            </div>
          </div>

          <div class="input-wrap">
            <label for="passInput">Password</label>
            <div class="input-icon-wrap">
              <i class="fas fa-lock input-icon"></i>
              <input type="password" id="passInput" name="password" required placeholder="Enter your password">
              <button type="button" class="eye-btn" onclick="togglePass('passInput','eyeIcon')">
                <i class="fas fa-eye" id="eyeIcon"></i>
              </button>
            </div>
          </div>

          <button type="submit" class="auth-btn">
            <i class="fas fa-sign-in-alt"></i> Sign In
          </button>

        </form>

        <div class="auth-switch">
          Don't have an account? <a href="/signup">Create one</a>
        </div>

        <div class="health-tip">
          <i class="fas fa-lightbulb"></i>
          <span>Tip: A 10-minute walk after meals helps regulate blood glucose levels.</span>
        </div>

      </div>
    </div>

  </div>

<script>
function togglePass(inputId, iconId) {
  const input = document.getElementById(inputId);
  const icon  = document.getElementById(iconId);
  input.type  = input.type === 'password' ? 'text' : 'password';
  icon.className = input.type === 'password' ? 'fas fa-eye' : 'fas fa-eye-slash';
}
</script>
</body>
</html>
