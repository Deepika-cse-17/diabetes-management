<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>My Routines — Diabetes Management System</title>
  <link rel="stylesheet" href="/style.css">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
  <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">
</head>
<body>

  <!-- ── Sidebar Overlay (mobile) ── -->
  <div class="sidebar-overlay" id="sidebarOverlay" onclick="closeSidebar()"></div>

  <!-- ══════════════════════════════
       SIDEBAR
  ══════════════════════════════ -->
  <aside class="sidebar" id="sidebar">
    <div class="sidebar-logo">
      <a href="/">
        <i class="fas fa-heartbeat"></i>
        <span>Diabetes Management System</span>
      </a>
    </div>

    <nav class="sidebar-nav">
      <span class="nav-section-label">Main</span>
      <a href="/"><i class="fas fa-tachometer-alt"></i> Dashboard</a>
      <a href="/" class="active"><i class="fas fa-calendar-check"></i> My Routines</a>
      <a href="/"><i class="fas fa-tint"></i> Blood Sugar Log</a>

      <span class="nav-section-label">Health</span>
      <a href="/"><i class="fas fa-utensils"></i> Meals</a>
      <a href="/"><i class="fas fa-running"></i> Exercise</a>
      <a href="/"><i class="fas fa-pills"></i> Medication</a>
      <a href="/records"><i class="fas fa-file-medical-alt"></i> Reports</a>

      <span class="nav-section-label">Support</span>
      <a href="#"><i class="fas fa-robot"></i> Chatbot</a>
      <a href="#"><i class="fas fa-user-circle"></i> Profile</a>
      <a href="#"><i class="fas fa-cog"></i> Settings</a>
      <a href="/logout" class="logout-link"><i class="fas fa-sign-out-alt"></i> Logout</a>
    </nav>

    <div class="sidebar-bottom">
      <div class="glucose-meter-card">
        <i class="fas fa-stethoscope"></i>
        <strong>Health Monitor</strong>
        <p>Track your glucose and stay healthy every day</p>
      </div>
    </div>
  </aside>

  <!-- ══════════════════════════════
       TOP BAR
  ══════════════════════════════ -->
  <header class="topbar">
    <div class="topbar-left">
      <button class="hamburger" id="hamburgerBtn" onclick="toggleSidebar()" aria-label="Toggle menu">
        <i class="fas fa-bars"></i>
      </button>
      <span class="topbar-page-title">
        <i class="fas fa-calendar-check" style="color:var(--primary);margin-right:6px;"></i>
        <span id="topbarTitle">My Routines</span>
      </span>
    </div>

    <div class="topbar-right">
      <div class="lang-switcher">
        <button onclick="changeLanguage('en')" class="lang-btn active" id="btn-en">English</button>
        <button onclick="changeLanguage('ta')" class="lang-btn" id="btn-ta">&#2980;&#2990;&#3007;&#2996;&#3021;</button>
      </div>

      <button class="notif-btn" aria-label="Notifications">
        <i class="fas fa-bell"></i>
      </button>

      <div class="user-info" aria-label="User profile">
        <div class="user-avatar"><%= userName ? userName.charAt(0).toUpperCase() : 'D' %></div>
        <div class="user-meta">
          <span class="user-name"><%= userName %></span>
          <span class="user-role">Patient</span>
        </div>
      </div>
    </div>
  </header>

  <!-- ══════════════════════════════
       PAGE CONTENT
  ══════════════════════════════ -->
  <div class="page-wrapper">

    <!-- Tip banner -->
    <div class="tip-banner">
      <i class="fas fa-info-circle tip-icon"></i>
      <div class="tip-track">
        <span class="tip-scroll" id="tipText">
          Walk 10 minutes after meals to help regulate blood glucose &nbsp;&nbsp;|&nbsp;&nbsp;
          Include more fibre and green vegetables in your diet &nbsp;&nbsp;|&nbsp;&nbsp;
          Drink at least 8 glasses of water daily &nbsp;&nbsp;|&nbsp;&nbsp;
          Aim for 7 to 8 hours of sleep for better glucose control &nbsp;&nbsp;|&nbsp;&nbsp;
          5 minutes of deep breathing can help reduce stress levels
        </span>
      </div>
    </div>

    <div class="page-content">

      <!-- Welcome -->
      <div class="welcome-banner">
        <h1 id="pageTitle">Daily Health Log</h1>
        <p id="pageSubtitle">Record your health data for today and receive personalised insights</p>
      </div>

      <form action="/submit" method="POST" id="mainForm">
        <input type="hidden" name="language" id="language" value="en">

        <!-- Personal Information -->
        <div class="section-card">
          <div class="section-header">
            <div class="section-icon"><i class="fas fa-user"></i></div>
            <h2 id="personalTitle">Personal Information</h2>
          </div>
          <div class="form-grid">
            <div class="input-group">
              <label id="nameLabel">Full Name</label>
              <input type="text" name="name" required placeholder="Enter your name" autocomplete="name">
            </div>
            <div class="input-group">
              <label id="ageLabel">Age</label>
              <input type="number" name="age" required placeholder="Enter your age" min="1" max="120">
            </div>
            <div class="input-group full-width">
              <label id="gLabel">Blood Glucose (mg/dL)</label>
              <input type="number" name="glucose" required placeholder="e.g., 110" min="20" max="600">
              <span class="hint" id="gHint">Normal fasting range: 70 – 140 mg/dL</span>
            </div>
          </div>
        </div>

        <!-- Meals -->
        <div class="section-card">
          <div class="section-header">
            <div class="section-icon"><i class="fas fa-utensils"></i></div>
            <h2 id="mTitle">Meals</h2>
          </div>
          <div class="form-grid">
            <div class="input-group">
              <label id="bLabel">Breakfast</label>
              <input type="text" name="breakfast" placeholder="e.g., Idli, Tea">
            </div>
            <div class="input-group">
              <label id="lLabel">Lunch</label>
              <input type="text" name="lunch" placeholder="e.g., Rice, Dal">
            </div>
            <div class="input-group">
              <label id="dLabel">Dinner</label>
              <input type="text" name="dinner" placeholder="e.g., Chapati, Sabzi">
            </div>
            <div class="input-group">
              <label id="sLabel">Snacks</label>
              <input type="text" name="snacks" placeholder="e.g., Fruits, Nuts">
            </div>
          </div>
        </div>

        <!-- Wellness -->
        <div class="section-card">
          <div class="section-header">
            <div class="section-icon"><i class="fas fa-heart"></i></div>
            <h2 id="wellTitle">Wellness</h2>
          </div>
          <div class="form-grid">
            <div class="input-group">
              <label id="aLabel">Physical Activity</label>
              <input type="text" name="activity" placeholder="e.g., Walking 30 mins">
            </div>
            <div class="input-group">
              <label id="medLabel">Meditation</label>
              <input type="text" name="meditation" placeholder="e.g., 10 mins">
            </div>
            <div class="input-group full-width">
              <label id="stLabel">Stress / Day Notes</label>
              <textarea name="stressNote" placeholder="Describe how you felt today..."></textarea>
            </div>
          </div>
        </div>

        <button type="submit" class="submit-btn" id="submitBtn">
          <i class="fas fa-chart-line"></i>
          <span id="btnText">Analyse &amp; Get Recommendations</span>
        </button>

      </form>

    </div><!-- end page-content -->

    <footer class="footer">
      Diabetes Management System &copy; <%= new Date().getFullYear() %> &nbsp;|&nbsp; Consult your doctor for medical advice
    </footer>
  </div><!-- end page-wrapper -->

<script>
  // ── Sidebar toggle ──
  function toggleSidebar() {
    document.getElementById('sidebar').classList.toggle('open');
    document.getElementById('sidebarOverlay').classList.toggle('open');
  }
  function closeSidebar() {
    document.getElementById('sidebar').classList.remove('open');
    document.getElementById('sidebarOverlay').classList.remove('open');
  }

  // ── Language switcher ──
  function changeLanguage(lang) {
    document.getElementById('language').value = lang;
    document.querySelectorAll('.lang-btn').forEach(b => b.classList.remove('active'));
    document.getElementById('btn-' + lang).classList.add('active');

    if (lang === 'ta') {
      document.getElementById('pageTitle').innerText        = '\u0b85\u0ba9\u0bcd\u0bb1\u0bbe\u0b9f \u0b86\u0bb0\u0bcb\u0b95\u0bcd\u0b95\u0bbf\u0baf \u0baa\u0ba4\u0bbf\u0bb5\u0bc1';
      document.getElementById('pageSubtitle').innerText     = '\u0b87\u0ba9\u0bcd\u0bb1\u0bc8\u0baf \u0b86\u0bb0\u0bcb\u0b95\u0bcd\u0b95\u0bbf\u0baf \u0ba4\u0b95\u0bb5\u0bb2\u0bcd\u0b95\u0bb3\u0bc8 \u0baa\u0ba4\u0bbf\u0bb5\u0bc1 \u0b9a\u0bc6\u0baf\u0bcd\u0baf\u0bc1\u0b99\u0bcd\u0b95\u0bb3\u0bcd';
      document.getElementById('topbarTitle').innerText      = '\u0b8e\u0ba9\u0bcd \u0bb5\u0bb4\u0b95\u0bcd\u0b95\u0bae\u0bcd';
      document.getElementById('personalTitle').innerText    = '\u0ba4\u0ba9\u0bbf\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u0b9f \u0ba4\u0b95\u0bb5\u0bb2\u0bcd';
      document.getElementById('nameLabel').innerText        = '\u0baa\u0bc6\u0baf\u0bb0\u0bcd';
      document.getElementById('ageLabel').innerText         = '\u0bb5\u0baf\u0ba4\u0bc1';
      document.getElementById('gLabel').innerText           = '\u0b87\u0bb0\u0ba4\u0bcd\u0ba4 \u0b9a\u0bb0\u0bcd\u0b95\u0bcd\u0b95\u0bb0\u0bc8 (mg/dL)';
      document.getElementById('gHint').innerText            = '\u0b9a\u0bbe\u0ba4\u0bbe\u0bb0\u0ba3 \u0b85\u0bb3\u0bb5\u0bc1: 70 \u2013 140 mg/dL';
      document.getElementById('mTitle').innerText           = '\u0b89\u0ba3\u0bb5\u0bc1 \u0bb5\u0bbf\u0bb5\u0bb0\u0b99\u0bcd\u0b95\u0bb3\u0bcd';
      document.getElementById('bLabel').innerText           = '\u0b95\u0bbe\u0bb2\u0bc8 \u0b89\u0ba3\u0bb5\u0bc1';
      document.getElementById('lLabel').innerText           = '\u0bae\u0ba4\u0bbf\u0baf \u0b89\u0ba3\u0bb5\u0bc1';
      document.getElementById('dLabel').innerText           = '\u0b87\u0bb0\u0bb5\u0bc1 \u0b89\u0ba3\u0bb5\u0bc1';
      document.getElementById('sLabel').innerText           = '\u0b9a\u0bbf\u0bb1\u0bcd\u0bb1\u0bc1\u0ba3\u0bcd\u0b9f\u0bbf';
      document.getElementById('wellTitle').innerText        = '\u0b86\u0bb0\u0bcb\u0b95\u0bcd\u0b95\u0bbf\u0baf\u0bae\u0bcd';
      document.getElementById('aLabel').innerText           = '\u0b89\u0b9f\u0bb1\u0bcd\u0baa\u0baf\u0bbf\u0bb1\u0bcd\u0b9a\u0bbf';
      document.getElementById('medLabel').innerText         = '\u0ba4\u0bbf\u0baf\u0bbe\u0ba9\u0bae\u0bcd';
      document.getElementById('stLabel').innerText          = '\u0bae\u0ba9 \u0b85\u0bb4\u0bc1\u0ba4\u0bcd\u0ba4 \u0b95\u0bc1\u0bb1\u0bbf\u0baa\u0bcd\u0baa\u0bc1\u0b95\u0bb3\u0bcd';
      document.getElementById('btnText').innerText          = '\u0baa\u0b95\u0bc1\u0baa\u0bcd\u0baa\u0bbe\u0baf\u0bcd\u0bb5\u0bc1 \u0b9a\u0bc6\u0baf\u0bcd';
      document.getElementsByName('name')[0].placeholder       = '\u0b89\u0b99\u0bcd\u0b95\u0bb3\u0bcd \u0baa\u0bc6\u0baf\u0bb0\u0bcd';
      document.getElementsByName('age')[0].placeholder        = '\u0b89\u0b99\u0bcd\u0b95\u0bb3\u0bcd \u0bb5\u0baf\u0ba4\u0bc1';
      document.getElementsByName('glucose')[0].placeholder    = '\u0b8e.\u0b95\u0bbe., 110';
      document.getElementsByName('breakfast')[0].placeholder  = '\u0b8e.\u0b95\u0bbe., \u0b87\u0b9f\u0bcd\u0bb2\u0bbf, \u0b9f\u0bc0';
      document.getElementsByName('lunch')[0].placeholder      = '\u0b8e.\u0b95\u0bbe., \u0b85\u0bb0\u0bbf\u0b9a\u0bbf, \u0baa\u0bb0\u0bc1\u0baa\u0bcd\u0baa\u0bc1';
      document.getElementsByName('dinner')[0].placeholder     = '\u0b8e.\u0b95\u0bbe., \u0b9a\u0baa\u0bcd\u0baa\u0bbe\u0ba4\u0bcd\u0ba4\u0bbf, \u0b95\u0bbe\u0baf\u0bcd\u0b95\u0bb1\u0bbf';
      document.getElementsByName('snacks')[0].placeholder     = '\u0b8e.\u0b95\u0bbe., \u0baa\u0bb4\u0bae\u0bcd, \u0ba8\u0b9f\u0bcd\u0b9f\u0bc1\u0b95\u0bb3\u0bcd';
      document.getElementsByName('activity')[0].placeholder   = '\u0b8e.\u0b95\u0bbe., 30 \u0ba8\u0bbf\u0bae\u0bbf\u0b9f \u0ba8\u0b9f\u0bc8';
      document.getElementsByName('meditation')[0].placeholder = '\u0b8e.\u0b95\u0bbe., 10 \u0ba8\u0bbf\u0bae\u0bbf\u0b9f \u0ba4\u0bbf\u0baf\u0bbe\u0ba9\u0bae\u0bcd';
      document.getElementsByName('stressNote')[0].placeholder = '\u0b87\u0ba9\u0bcd\u0bb1\u0bc8\u0baf \u0b85\u0ba9\u0bc1\u0baa\u0bb5\u0ba4\u0bcd\u0ba4\u0bc8 \u0bb5\u0bbf\u0bb5\u0bb0\u0bbf\u0b95\u0bcd\u0b95\u0bb5\u0bc1\u0bae\u0bcd...';
      document.getElementById('tipText').innerText =
        '\u0b9a\u0bbe\u0baa\u0bcd\u0baa\u0bbf\u0b9f\u0bcd\u0b9f \u0baa\u0bbf\u0ba9\u0bcd 10 \u0ba8\u0bbf\u0bae\u0bbf\u0b9f\u0bae\u0bcd \u0ba8\u0b9f\u0b95\u0bcd\u0b95\u0bb5\u0bc1\u0bae\u0bcd  |  \u0baa\u0b9a\u0bcd\u0b9a\u0bc8 \u0b95\u0bbe\u0baf\u0bcd\u0b95\u0bb1\u0bbf \u0b85\u0ba4\u0bbf\u0b95\u0bae\u0bcd \u0b9a\u0bbe\u0baa\u0bcd\u0baa\u0bbf\u0b9f\u0bb5\u0bc1\u0bae\u0bcd  |  \u0ba4\u0bbf\u0ba9\u0bae\u0bc1\u0bae\u0bcd 8 \u0b95\u0bbf\u0bb3\u0bbe\u0b9a\u0bcd \u0ba4\u0ba3\u0bcd\u0ba3\u0bc0\u0bb0\u0bcd \u0b95\u0bc1\u0b9f\u0bbf\u0b95\u0bcd\u0b95\u0bb5\u0bc1\u0bae\u0bcd';
    } else {
      location.reload();
    }
  }
</script>

</body>
</html>
