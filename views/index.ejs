<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>DiabetesCare — Daily Tracker</title>
  <link rel="stylesheet" href="/style.css">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
  <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">
</head>
<body>

  <header class="topbar">
    <div class="topbar-inner">
      <div class="brand">
        <i class="fas fa-heartbeat brand-icon"></i>
        <span>DiabetesCare</span>
      </div>
      <div class="topbar-right">
        <span class="user-greeting"><i class="fas fa-user-circle"></i> <%= userName %></span>
        <div class="lang-switcher">
          <button onclick="changeLanguage('en')" class="lang-btn active" id="btn-en">EN</button>
          <button onclick="changeLanguage('ta')" class="lang-btn" id="btn-ta">தமிழ்</button>
        </div>
        <a href="/logout" class="logout-btn"><i class="fas fa-sign-out-alt"></i> Logout</a>
      </div>
    </div>
  </header>

  <div class="tip-banner">
    <i class="fas fa-info-circle tip-icon"></i>
    <div class="tip-track">
      <span class="tip-scroll" id="tipText">
        Walk 10 minutes after meals to help regulate blood glucose &nbsp;&nbsp;|&nbsp;&nbsp;
        Include more fibre and green vegetables in your diet &nbsp;&nbsp;|&nbsp;&nbsp;
        Drink at least 8 glasses of water daily &nbsp;&nbsp;|&nbsp;&nbsp;
        Aim for 7 to 8 hours of sleep for better glucose control &nbsp;&nbsp;|&nbsp;&nbsp;
        5 minutes of deep breathing can help reduce stress levels
      </span>
    </div>
  </div>

  <div class="page-header">
    <div class="page-header-inner">
      <div>
        <h1 id="title">Daily Health Log</h1>
        <p id="subtitle">Record your health data for today and receive personalised insights</p>
      </div>
    </div>
  </div>

  <main class="main-container">
    <form action="/submit" method="POST" id="mainForm">
      <input type="hidden" name="language" id="language" value="en">

      <div class="section-card">
        <div class="section-header">
          <div class="section-icon"><i class="fas fa-user"></i></div>
          <h2 id="personalTitle">Personal Information</h2>
        </div>
        <div class="form-grid">
          <div class="input-group">
            <label id="nameLabel">Full Name</label>
            <input type="text" name="name" required placeholder="Enter your name">
          </div>
          <div class="input-group">
            <label id="ageLabel">Age</label>
            <input type="number" name="age" required placeholder="Enter your age" min="1" max="120">
          </div>
          <div class="input-group full-width">
            <label id="gLabel">Blood Glucose (mg/dL)</label>
            <input type="number" name="glucose" required placeholder="e.g., 110">
            <span class="hint" id="gHint">Normal fasting range: 70 – 140 mg/dL</span>
          </div>
        </div>
      </div>

      <div class="section-card">
        <div class="section-header">
          <div class="section-icon"><i class="fas fa-utensils"></i></div>
          <h2 id="mTitle">Meals</h2>
        </div>
        <div class="form-grid">
          <div class="input-group">
            <label id="bLabel">Breakfast</label>
            <input type="text" name="breakfast" placeholder="e.g., Idli, Tea">
          </div>
          <div class="input-group">
            <label id="lLabel">Lunch</label>
            <input type="text" name="lunch" placeholder="e.g., Rice, Dal">
          </div>
          <div class="input-group">
            <label id="dLabel">Dinner</label>
            <input type="text" name="dinner" placeholder="e.g., Chapati, Sabzi">
          </div>
          <div class="input-group">
            <label id="sLabel">Snacks</label>
            <input type="text" name="snacks" placeholder="e.g., Fruits, Nuts">
          </div>
        </div>
      </div>

      <div class="section-card">
        <div class="section-header">
          <div class="section-icon"><i class="fas fa-heart"></i></div>
          <h2 id="wellTitle">Wellness</h2>
        </div>
        <div class="form-grid">
          <div class="input-group">
            <label id="aLabel">Physical Activity</label>
            <input type="text" name="activity" placeholder="e.g., Walking 30 mins">
          </div>
          <div class="input-group">
            <label id="medLabel">Meditation</label>
            <input type="text" name="meditation" placeholder="e.g., 10 mins">
          </div>
          <div class="input-group full-width">
            <label id="stLabel">Stress / Day Notes</label>
            <textarea name="stressNote" placeholder="Describe how you felt today..."></textarea>
          </div>
        </div>
      </div>

      <button type="submit" class="submit-btn" id="btn">
        <i class="fas fa-chart-line"></i>
        <span id="btnText">Analyse & Get Recommendations</span>
      </button>

    </form>
  </main>

  <footer class="footer">
    <p>DiabetesCare &copy; <%= new Date().getFullYear() %> &nbsp;|&nbsp; Consult your doctor for medical advice</p>
  </footer>

<script>
function changeLanguage(lang) {
  document.getElementById('language').value = lang;
  document.querySelectorAll('.lang-btn').forEach(b => b.classList.remove('active'));
  document.getElementById('btn-' + lang).classList.add('active');
  if (lang === 'ta') {
    document.getElementById('title').innerText         = 'அன்றாட ஆரோக்கிய பதிவு';
    document.getElementById('subtitle').innerText      = 'இன்றைய ஆரோக்கிய தகவல்களை பதிவு செய்யுங்கள்';
    document.getElementById('personalTitle').innerText = 'தனிப்பட்ட தகவல்';
    document.getElementById('nameLabel').innerText     = 'பெயர்';
    document.getElementById('ageLabel').innerText      = 'வயது';
    document.getElementById('gLabel').innerText        = 'இரத்த சர்க்கரை (mg/dL)';
    document.getElementById('gHint').innerText         = 'சாதாரண அளவு: 70 – 140 mg/dL';
    document.getElementById('mTitle').innerText        = 'உணவு விவரங்கள்';
    document.getElementById('bLabel').innerText        = 'காலை உணவு';
    document.getElementById('lLabel').innerText        = 'மதிய உணவு';
    document.getElementById('dLabel').innerText        = 'இரவு உணவு';
    document.getElementById('sLabel').innerText        = 'சிற்றுண்டி';
    document.getElementById('wellTitle').innerText     = 'ஆரோக்கியம்';
    document.getElementById('aLabel').innerText        = 'உடற்பயிற்சி';
    document.getElementById('medLabel').innerText      = 'தியானம்';
    document.getElementById('stLabel').innerText       = 'மன அழுத்த குறிப்புகள்';
    document.getElementById('btnText').innerText       = 'பகுப்பாய்வு செய்';
    document.getElementsByName('name')[0].placeholder       = 'உங்கள் பெயர்';
    document.getElementsByName('age')[0].placeholder        = 'உங்கள் வயது';
    document.getElementsByName('glucose')[0].placeholder    = 'எ.கா., 110';
    document.getElementsByName('breakfast')[0].placeholder  = 'எ.கா., இட்லி, டீ';
    document.getElementsByName('lunch')[0].placeholder      = 'எ.கா., அரிசி, பருப்பு';
    document.getElementsByName('dinner')[0].placeholder     = 'எ.கா., சப்பாத்தி, காய்கறி';
    document.getElementsByName('snacks')[0].placeholder     = 'எ.கா., பழம், நட்டுகள்';
    document.getElementsByName('activity')[0].placeholder   = 'எ.கா., 30 நிமிட நடை';
    document.getElementsByName('meditation')[0].placeholder = 'எ.கா., 10 நிமிட தியானம்';
    document.getElementsByName('stressNote')[0].placeholder = 'இன்றைய அனுபவத்தை விவரிக்கவும்...';
    document.getElementById('tipText').innerText =
      'சாப்பிட்ட பின் 10 நிமிடம் நடக்கவும்  |  பச்சை காய்கறி அதிகம் சாப்பிடவும்  |  தினமும் 8 கிளாஸ் தண்ணீர் குடிக்கவும்';
  } else {
    location.reload();
  }
}
</script>

</body>
</html>
