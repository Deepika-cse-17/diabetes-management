<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Reports — Diabetes Management System</title>
  <link rel="stylesheet" href="/style.css">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
  <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">
</head>
<body>
<%- include('partials/sidebar') %>
<div class="page-wrapper">
  <%- include('partials/topbar', { topbarTitle: '<i class="fas fa-file-medical-alt" style="color:var(--primary);margin-right:6px;"></i> Reports' }) %>
  <div class="page-content">
    <div class="welcome-banner"><h1>Health Reports</h1><p>All your logged health records.</p></div>
    <% if(records.length>0){ %>
    <div class="card" style="margin-bottom:20px;">
      <div class="card-body" style="display:flex;gap:12px;flex-wrap:wrap;">
        <a href="/download-pdf?name=<%= records[0].name %>&age=<%= records[0].age %>" class="pdf-btn"><i class="fas fa-file-pdf"></i> Download PDF Report</a>
      </div>
    </div>
    <% } %>
    <div class="card">
      <div class="card-header"><h3><i class="fas fa-table"></i> Complete Health History</h3></div>
      <div class="table-wrap">
        <table class="data-table">
          <thead><tr><th>Date</th><th>Glucose</th><th>Status</th><th>Activity</th><th>Meditation</th><th>Stress Note</th></tr></thead>
          <tbody>
            <% if(records.length===0){ %><tr><td colspan="6" style="text-align:center;padding:24px;color:#94a3b8;">No records yet. <a href="/routines">Log your first routine</a>.</td></tr><% } %>
            <% records.forEach(function(r){ %>
            <tr>
              <td><%= new Date(r.date).toLocaleDateString('en-US',{month:'short',day:'numeric',year:'numeric'}) %></td>
              <td><strong><%= r.glucose %> mg/dL</strong></td>
              <td><span class="glucose-badge <%= r.glucose>180?'badge-high':r.glucose<70?'badge-low':'badge-normal' %>"><%= r.glucose>180?'High':r.glucose<70?'Low':'Normal' %></span></td>
              <td><%= r.activity||'—' %></td>
              <td><%= r.meditation||'—' %></td>
              <td><%= r.stressNote ? r.stressNote.substring(0,40)+'...' : '—' %></td>
            </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
  <footer class="footer">Diabetes Management System &copy; <%= new Date().getFullYear() %></footer>
</div>
<script>
function toggleSidebar(){document.getElementById('sidebar').classList.toggle('open');document.getElementById('sidebarOverlay').classList.toggle('open');}
function closeSidebar(){document.getElementById('sidebar').classList.remove('open');document.getElementById('sidebarOverlay').classList.remove('open');}
function setLang(l){document.querySelectorAll('.lang-btn').forEach(b=>b.classList.remove('active'));document.getElementById('btn-'+l).classList.add('active');}
</script>
</body></html>
