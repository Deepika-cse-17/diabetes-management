<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Health Report — Diabetes Management System</title>
  <link rel="stylesheet" href="/style.css">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
  <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">
</head>
<body>
<%- include('partials/sidebar') %>
<div class="page-wrapper">
  <% var topbarTitle = '<i class="fas fa-chart-line" style="color:var(--primary);margin-right:6px;"></i> Health Report'; %>
  <%- include('partials/topbar') %>
  <div class="page-content">

    <div class="welcome-banner">
      <h1><%= language==='ta' ? 'ஆரோக்கிய அறிக்கை' : 'Health Report' %></h1>
      <p><%= language==='ta' ? 'இன்றைய பகுப்பாய்வு முடிந்தது' : 'Analysis complete for' %> <%= routine.date.toDateString() %></p>
    </div>

    <!-- Stat Cards -->
    <div class="stats-row">
      <div class="stat-card">
        <div class="stat-icon-wrap si-blue"><i class="fas fa-user"></i></div>
        <div class="stat-body">
          <div class="stat-value"><%= routine.name %></div>
          <div class="stat-label"><%= language==='ta' ? 'நோயாளி' : 'Patient' %></div>
        </div>
      </div>
      <div class="stat-card">
        <div class="stat-icon-wrap si-teal"><i class="fas fa-user-clock"></i></div>
        <div class="stat-body">
          <div class="stat-value"><%= routine.age %> yrs</div>
          <div class="stat-label"><%= language==='ta' ? 'வயது' : 'Age' %></div>
        </div>
      </div>
      <div class="stat-card">
        <div class="stat-icon-wrap <%= routine.glucose>180?'si-red':routine.glucose<70?'si-orange':'si-green' %>"><i class="fas fa-tint"></i></div>
        <div class="stat-body">
          <div class="stat-value"><%= routine.glucose %> <span style="font-size:0.8rem;color:var(--text-sub)">mg/dL</span>
            <span class="glucose-badge <%= routine.glucose>180?'badge-high':routine.glucose<70?'badge-low':'badge-normal' %>">
              <%= routine.glucose>180?'High':routine.glucose<70?'Low':'Normal' %>
            </span>
          </div>
          <div class="stat-label"><%= language==='ta' ? 'இரத்த சர்க்கரை' : 'Blood Glucose' %></div>
        </div>
      </div>
      <div class="stat-card">
        <div class="stat-icon-wrap si-purple"><i class="fas fa-calendar-day"></i></div>
        <div class="stat-body">
          <div class="stat-value" style="font-size:0.9rem;"><%= routine.date.toDateString() %></div>
          <div class="stat-label"><%= language==='ta' ? 'தேதி' : 'Date' %></div>
        </div>
      </div>
    </div>

    <!-- Main grid -->
    <div class="dashboard-grid">

      <!-- Today's Log -->
      <div class="card">
        <div class="card-header"><h3><i class="fas fa-clipboard-list"></i> <%= language==='ta' ? 'இன்றைய பதிவு' : "Today's Log" %></h3></div>
        <div class="card-body" style="padding:16px 20px;">
          <div class="details-grid">
            <div class="detail-item"><div class="detail-icon"><i class="fas fa-coffee"></i></div><div><span class="detail-label"><%= language==='ta'?'காலை உணவு':'Breakfast' %></span><span class="detail-value"><%= routine.breakfast||'—' %></span></div></div>
            <div class="detail-item"><div class="detail-icon"><i class="fas fa-sun"></i></div><div><span class="detail-label"><%= language==='ta'?'மதிய உணவு':'Lunch' %></span><span class="detail-value"><%= routine.lunch||'—' %></span></div></div>
            <div class="detail-item"><div class="detail-icon"><i class="fas fa-moon"></i></div><div><span class="detail-label"><%= language==='ta'?'இரவு உணவு':'Dinner' %></span><span class="detail-value"><%= routine.dinner||'—' %></span></div></div>
            <div class="detail-item"><div class="detail-icon"><i class="fas fa-apple-alt"></i></div><div><span class="detail-label"><%= language==='ta'?'சிற்றுண்டி':'Snacks' %></span><span class="detail-value"><%= routine.snacks||'—' %></span></div></div>
            <div class="detail-item"><div class="detail-icon"><i class="fas fa-running"></i></div><div><span class="detail-label"><%= language==='ta'?'உடற்பயிற்சி':'Activity' %></span><span class="detail-value"><%= routine.activity||'—' %></span></div></div>
            <div class="detail-item"><div class="detail-icon"><i class="fas fa-brain"></i></div><div><span class="detail-label"><%= language==='ta'?'தியானம்':'Meditation' %></span><span class="detail-value"><%= routine.meditation||'—' %></span></div></div>
            <div class="detail-item full-width"><div class="detail-icon"><i class="fas fa-comment-alt"></i></div><div><span class="detail-label"><%= language==='ta'?'மன அழுத்தம்':'Stress Note' %></span><span class="detail-value"><%= routine.stressNote||'—' %></span></div></div>
          </div>
        </div>
      </div>

      <!-- Today's Summary -->
      <div class="card">
        <div class="card-header"><h3><i class="fas fa-clipboard-check"></i> <%= language==='ta'?'இன்றைய சுருக்கம்':"Today's Summary" %></h3></div>
        <div class="summary-list">
          <% var mealsLogged=[routine.breakfast,routine.lunch,routine.dinner].filter(function(m){return m&&m.length>0}).length; %>
          <% var exDone=routine.activity&&routine.activity.length>2?1:0; %>
          <% var medDone=routine.meditation&&routine.meditation.length>2?1:0; %>

          <div class="summary-item">
            <div class="summary-icon si-orange"><i class="fas fa-utensils"></i></div>
            <div class="summary-text"><div class="s-label"><%= language==='ta'?'உணவுகள்':'Meals' %></div><div class="s-sub"><%= mealsLogged %> / 3 <%= language==='ta'?'பதிவு':'Completed' %></div></div>
            <div class="summary-check <%= mealsLogged===3?'done':'' %>"><i class="fas fa-<%= mealsLogged===3?'check-circle':'circle' %>"></i></div>
          </div>
          <div class="summary-item">
            <div class="summary-icon si-green"><i class="fas fa-running"></i></div>
            <div class="summary-text"><div class="s-label"><%= language==='ta'?'உடற்பயிற்சி':'Exercise' %></div><div class="s-sub"><%= exDone %> / 1 <%= language==='ta'?'முடிந்தது':'Completed' %></div></div>
            <div class="summary-check <%= exDone?'done':'' %>"><i class="fas fa-<%= exDone?'check-circle':'circle' %>"></i></div>
          </div>
          <div class="summary-item">
            <div class="summary-icon si-purple"><i class="fas fa-brain"></i></div>
            <div class="summary-text"><div class="s-label"><%= language==='ta'?'தியானம்':'Meditation' %></div><div class="s-sub"><%= medDone %> / 1 <%= language==='ta'?'முடிந்தது':'Completed' %></div></div>
            <div class="summary-check <%= medDone?'done':'' %>"><i class="fas fa-<%= medDone?'check-circle':'circle' %>"></i></div>
          </div>
          <div class="summary-item">
            <div class="summary-icon si-teal"><i class="fas fa-tint"></i></div>
            <div class="summary-text"><div class="s-label"><%= language==='ta'?'தண்ணீர்':'Water Intake' %></div><div class="s-sub">Track daily</div></div>
            <div class="summary-check"><div class="mini-progress"><div class="mini-fill" style="width:75%"></div></div></div>
          </div>
        </div>
      </div>
    </div>

    <!-- Recommendations + Chatbot -->
    <div class="bottom-grid">
      <div class="card">
        <div class="card-header"><h3><i class="fas fa-stethoscope"></i> <%= language==='ta'?'பரிந்துரைகள்':'Clinical Recommendations' %></h3></div>
        <div class="card-body">
          <div class="rec-list">
            <% recommendations.forEach(function(r){ %>
            <div class="rec-item <%= r.severity.toLowerCase() %>">
              <div class="rec-bar"></div>
              <div class="rec-icon"><i class="fas fa-<%= r.severity==='High'?'exclamation-circle':r.severity==='Medium'?'exclamation-triangle':'check-circle' %>"></i></div>
              <div class="rec-body"><span class="rec-badge"><%= r.severity %></span><p><%= r.text %></p></div>
            </div>
            <% }) %>
          </div>
          <div class="report-actions" style="margin-top:16px;display:flex;gap:12px;flex-wrap:wrap;">
            <a href="/download-pdf?name=<%= routine.name %>&age=<%= routine.age %>" class="pdf-btn"><i class="fas fa-file-pdf"></i> <%= language==='ta'?'PDF பதிவிறக்கம்':'Download PDF Report' %></a>
            <a href="/routines" class="pdf-btn" style="background:#1a56db;"><i class="fas fa-plus"></i> <%= language==='ta'?'மீண்டும் பதிவு':'Log Another Day' %></a>
          </div>
        </div>
      </div>

      <!-- Inline Chatbot -->
      <div class="card chatbot-panel" id="chatbotPanel">
        <div class="card-header"><h3><i class="fas fa-robot"></i> <%= language==='ta'?'ஆரோக்கிய உதவியாளர்':'Health Assistant' %></h3></div>
        <div class="chatbot-intro-bar"><%= language==='ta'?'நீரிழிவு தொடர்பான கேள்விகளை கேளுங்கள்.':'Ask me anything about diabetes management.' %></div>
        <div id="chat-messages"></div>
        <div class="chatbot-input-row">
          <input type="text" id="userMsg" placeholder="<%= language==='ta'?'கேள்வி கேளுங்கள்...':'Type your question...' %>" onkeypress="if(event.key==='Enter')sendMsg()">
          <button onclick="sendMsg()"><i class="fas fa-paper-plane"></i></button>
        </div>
      </div>
    </div>

    <!-- Quick Actions -->
    <div class="card" style="margin-bottom:20px;">
      <div class="card-header"><h3><i class="fas fa-bolt"></i> <%= language==='ta'?'விரைவு செயல்கள்':'Quick Actions' %></h3></div>
      <div class="quick-actions-grid">
        <a href="/routines" class="qa-btn qa-blue"><i class="fas fa-plus-circle"></i> <%= language==='ta'?'வழக்கம் சேர்':'Add Routine' %></a>
        <a href="/blood-sugar" class="qa-btn qa-green"><i class="fas fa-tint"></i> <%= language==='ta'?'சர்க்கரை பதிவு':'Log Blood Sugar' %></a>
        <a href="/download-pdf?name=<%= routine.name %>&age=<%= routine.age %>" class="qa-btn qa-orange"><i class="fas fa-file-pdf"></i> <%= language==='ta'?'அறிக்கை':'Generate Report' %></a>
        <a href="#" onclick="document.getElementById('userMsg').focus();return false;" class="qa-btn qa-purple"><i class="fas fa-robot"></i> <%= language==='ta'?'உதவி கேள்':'Ask Chatbot' %></a>
      </div>
    </div>

  </div>
  <footer class="footer">Diabetes Management System &copy; <%= new Date().getFullYear() %> &nbsp;|&nbsp; Consult your doctor for medical advice</footer>
</div>

<script>
function toggleSidebar(){document.getElementById('sidebar').classList.toggle('open');document.getElementById('sidebarOverlay').classList.toggle('open');}
function closeSidebar(){document.getElementById('sidebar').classList.remove('open');document.getElementById('sidebarOverlay').classList.remove('open');}
function setLang(l){document.querySelectorAll('.lang-btn').forEach(b=>b.classList.remove('active'));document.getElementById('btn-'+l).classList.add('active');}
function sendMsg(){
  const input=document.getElementById('userMsg'),msg=input.value.trim();
  if(!msg)return;
  const box=document.getElementById('chat-messages');
  box.innerHTML+=`<div class="chat-msg user"><span>${msg}</span></div>`;
  fetch('/chatbot',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({message:msg,language:'<%= language %>'})})
  .then(r=>r.json()).then(d=>{
    box.innerHTML+=`<div class="chat-msg bot"><i class="fas fa-robot"></i><span>${d.reply}</span></div>`;
    box.scrollTop=box.scrollHeight;
  });
  input.value='';box.scrollTop=box.scrollHeight;
}
</script>
</body></html>
